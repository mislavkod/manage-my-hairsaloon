@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .home-hero {
        text-align: center;
        margin: 2rem 0 2.5rem;
    }
    .home-hero h1 {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 2.4rem;
        color: var(--clr-cream);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin: 0.4rem 0;
    }
    .hero-hat {
        display: block;
        margin: 0 auto;
        width: 110px;
        height: auto;
        transform-origin: 50% 100%; /* pivot at the hat brim */
        animation: hat-greet 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
    }
    .hero-mustache {
        display: block;
        margin: 0.6rem auto 0;
        width: 140px;
        height: auto;
    }
    @@keyframes hat-greet {
        0%   { transform: translateY(0)     rotate(0deg);   }
        25%  { transform: translateY(-38px) rotate(-14deg); }
        55%  { transform: translateY(-38px) rotate(-14deg); } /* hold at the "tip" */
        78%  { transform: translateY(-6px)  rotate(-3deg);  }
        90%  { transform: translateY(3px)   rotate(1deg);   } /* tiny settle-back */
        100% { transform: translateY(0)     rotate(0deg);   }
    }
</style>

<div class="home-hero">
    <svg class="hero-hat" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 58" aria-hidden="true">
        <rect x="4"  y="42" width="72" height="13" rx="6"  fill="#1C0F09" stroke="#C9A84C" stroke-width="2"/>
        <rect x="21" y="7"  width="38" height="37" rx="4"  fill="#1C0F09" stroke="#C9A84C" stroke-width="2"/>
        <rect x="21" y="33" width="38" height="8"          fill="#C9A84C"/>
        <rect x="23" y="34" width="34" height="2"  rx="1"  fill="#D97B2B" opacity="0.5"/>
        <rect x="23" y="9"  width="34" height="3"  rx="2"  fill="#4E1A0E" opacity="0.5"/>
    </svg>
    <h1>The Gentleman's Parlour</h1>
    <svg class="hero-mustache" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 38" aria-hidden="true">
        <path d="M50,20 C44,20 36,7 22,11 C10,14 6,25 14,29 C22,33 33,25 41,19 C45,16 49,18 50,20Z"
              fill="#1C0F09" stroke="#C9A84C" stroke-width="1.5"/>
        <path d="M50,20 C56,20 64,7 78,11 C90,14 94,25 86,29 C78,33 67,25 59,19 C55,16 51,18 50,20Z"
              fill="#1C0F09" stroke="#C9A84C" stroke-width="1.5"/>
        <ellipse cx="50" cy="19" rx="3" ry="2.5" fill="#C9A84C"/>
    </svg>
</div>

<div class="text-center mb-4">
    <p style="font-family: var(--font-body); color: var(--clr-sand); font-size: 1.05rem; letter-spacing: 0.06em;">
        Welcome to your salon management dashboard. Select a section below to get started.
    </p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-6 col-md-3">
        <a asp-controller="HairSalons" asp-action="Index" style="text-decoration:none;">
            <div class="stat-card">
                <div class="stat-icon">✂</div>
                <div class="stat-label">Hair Salons</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Staff" asp-action="Index" style="text-decoration:none;">
            <div class="stat-card">
                <div class="stat-icon">👤</div>
                <div class="stat-label">Staff</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Services" asp-action="Index" style="text-decoration:none;">
            <div class="stat-card">
                <div class="stat-icon">💈</div>
                <div class="stat-label">Services</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Reservations" asp-action="Index" style="text-decoration:none;">
            <div class="stat-card">
                <div class="stat-icon">📅</div>
                <div class="stat-label">Reservations</div>
            </div>
        </a>
    </div>
</div>

<div class="divider-ornament">— ◆ ◆ ◆ —</div>

<div class="row g-4 justify-content-center">
    @if (User.IsInRole("Admin"))
    {
        <div class="col-6 col-md-3">
            <a asp-controller="Users" asp-action="Index" style="text-decoration:none;">
                <div class="stat-card">
                    <div class="stat-icon">👥</div>
                    <div class="stat-label">Users</div>
                </div>
            </a>
        </div>
    }
    <div class="col-6 col-md-3">
        <a asp-controller="Reviews" asp-action="Index" style="text-decoration:none;">
            <div class="stat-card">
                <div class="stat-icon">★</div>
                <div class="stat-label">Reviews</div>
            </div>
        </a>
    </div>
</div>
