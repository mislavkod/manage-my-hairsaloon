@model List<manage_my_hairsaloon.Models.Reservation>
@{
    ViewData["Title"] = "Reservations";
    var active = ViewBag.ActiveStatus as string;
    string[] statuses = { "Pending", "Confirmed", "Completed", "Cancelled", "NoShow" };
}

<div class="page-header">
    <h1>Reservations</h1>
</div>

@* Status filter buttons *@
<div class="filter-bar" style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:1rem;">
    <button type="button" class="btn-outline-brass @(active == null ? "active" : "")"
            data-status="" onclick="setStatus(this)">All</button>
    @foreach (var s in statuses)
    {
        <button type="button" class="btn-outline-brass @(active == s ? "active" : "")"
                data-status="@s" onclick="setStatus(this)">@s</button>
    }
</div>

@* Text & date filters *@
<div class="filter-bar" style="display:flex; gap:1.5rem; flex-wrap:wrap; margin-bottom:1.5rem; align-items:flex-end;">
    <div style="display:flex; flex-direction:column; gap:0.3rem;">
        <label for="filterCustomerName" class="spinner-step-label">Customer</label>
        <input type="text" id="filterCustomerName" class="input-barbershop"
               placeholder="Filter by customer…" style="max-width:220px;" />
    </div>
    <div style="display:flex; flex-direction:column; gap:0.3rem;">
        <label for="filterServiceName" class="spinner-step-label">Service</label>
        <input type="text" id="filterServiceName" class="input-barbershop"
               placeholder="Filter by service…" style="max-width:220px;" />
    </div>
    <div style="min-width:220px;">
        @await Html.PartialAsync("_DatePicker", new manage_my_hairsaloon.ViewModels.DatePickerViewModel {
            Name = "filterDateFrom",
            Label = "From",
            Mode = "datetime",
            OnCommit = "onDateFilterChange"
        })
    </div>
    <div style="min-width:220px;">
        @await Html.PartialAsync("_DatePicker", new manage_my_hairsaloon.ViewModels.DatePickerViewModel {
            Name = "filterDateTo",
            Label = "Until",
            Mode = "datetime",
            OnCommit = "onDateFilterChange"
        })
    </div>
    <button type="button" id="clearDates" class="btn-outline-brass"
            style="align-self:flex-end;">Clear dates</button>
</div>

<div class="table-responsive">
    <table class="table-barbershop">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Staff</th>
                <th>Service</th>
                <th>Date &amp; Time</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="reservationsTableBody">
            @await Html.PartialAsync("_ReservationsTable", Model)
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    var _activeStatus = '@Html.Raw(active ?? "")';
    var _debounceTimer = null;

    function setStatus(btn) {
        var st = btn.dataset.status;
        _activeStatus = (_activeStatus === st) ? '' : st;
        document.querySelectorAll('[data-status]').forEach(function (b) {
            b.classList.toggle('active', b.dataset.status === _activeStatus);
        });
        doFetch();
    }

    function doFetch() {
        var params = new URLSearchParams({
            status: _activeStatus,
            customerName: document.getElementById('filterCustomerName').value,
            serviceName: document.getElementById('filterServiceName').value
        });
        var fromVal = document.getElementById('dp-filterDateFrom-hidden').value;
        var toVal   = document.getElementById('dp-filterDateTo-hidden').value;
        if (fromVal) params.set('dateFrom', fromVal);
        if (toVal)   params.set('dateTo', toVal);
        fetch('/reservations/filter?' + params.toString())
            .then(function (r) { return r.text(); })
            .then(function (html) {
                document.getElementById('reservationsTableBody').innerHTML = html;
            });
    }

    function debounce() {
        clearTimeout(_debounceTimer);
        _debounceTimer = setTimeout(doFetch, 300);
    }

    document.getElementById('filterCustomerName').addEventListener('input', debounce);
    document.getElementById('filterServiceName').addEventListener('input', debounce);

    // Called by both date pickers via data-dp-oncommit
    function onDateFilterChange() { debounce(); }

    document.getElementById('clearDates').addEventListener('click', function () {
        ['filterDateFrom', 'filterDateTo'].forEach(function (name) {
            var wrap = document.getElementById('dp-' + name);
            if (!wrap) return;
            wrap.querySelector('.dp-hidden').value = '';
            wrap.querySelector('.dp-display').textContent =
                (navigator.language || '').startsWith('hr') ? 'Odaberi datum' : 'Select a date';
        });
        doFetch();
    });
</script>
}
