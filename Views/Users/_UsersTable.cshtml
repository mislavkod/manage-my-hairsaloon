@model List<manage_my_hairsaloon.Models.User>
@if (Model.Any())
{
    foreach (var user in Model)
    {
        <tr>
            <td>@user.FirstName</td>
            <td>@user.LastName</td>
            <td>@user.Email</td>
            <td>@user.PhoneNumber</td>
            <td><span class="badge-brass">@user.Role</span></td>
            <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
            <td>
                <a asp-controller="Users" asp-action="Details" asp-route-id="@user.Id"
                   class="btn-outline-brass" style="font-size:0.72rem; padding:0.25rem 0.7rem;">Details</a>
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="7" style="text-align:center; color:var(--clr-sand); padding:1.5rem 0;">
            No users match the selected filters.
        </td>
    </tr>
}
