@model manage_my_hairsaloon.ViewModels.EditUserViewModel
@using manage_my_hairsaloon.Models

@{
    ViewData["Title"] = "Edit User";
}

<div class="page-header">
    <h1>Edit User</h1>
    <p style="color: var(--color-text-muted); font-size: 1.1em; letter-spacing: 0.1em; text-transform: uppercase;">
        @Model.FirstName @Model.LastName
    </p>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        
        <div asp-validation-summary="ModelOnly" style="background: rgba(201,168,76,0.15); border: 1px solid #C9A84C; border-radius:4px; padding:1rem; margin-bottom:1.5rem; color:#F5ECD7;"></div>

        <div class="card-barbershop leather-texture p-4 p-md-5">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="OriginalEmail" />
                <input type="hidden" asp-for="OriginalFirstName" />
                <input type="hidden" asp-for="OriginalLastName" />
                <input type="hidden" asp-for="OriginalPhoneNumber" />
                <input type="hidden" asp-for="OriginalRole" />

                <div class="form-group mb-4" style="margin-bottom: 1.5rem;">
                    <label asp-for="FirstName" class="section-title h5 mb-3" style="display:block;">First Name</label>
                    <input asp-for="FirstName" class="input-barbershop w-100" />
                    <span asp-validation-for="FirstName" class="text-danger" style="color:#D97B2B !important; font-size:0.85em;"></span>
                </div>

                <div class="form-group mb-4" style="margin-bottom: 1.5rem;">
                    <label asp-for="LastName" class="section-title h5 mb-3" style="display:block;">Last Name</label>
                    <input asp-for="LastName" class="input-barbershop w-100" />
                    <span asp-validation-for="LastName" class="text-danger" style="color:#D97B2B !important; font-size:0.85em;"></span>
                </div>

                <div class="form-group mb-4" style="margin-bottom: 1.5rem;">
                    <label asp-for="Email" class="section-title h5 mb-3" style="display:block;">Email</label>
                    <input asp-for="Email" type="email" class="input-barbershop w-100" />
                    <span asp-validation-for="Email" class="text-danger" style="color:#D97B2B !important; font-size:0.85em;"></span>
                </div>

                <div class="form-group mb-4" style="margin-bottom: 1.5rem;">
                    <label asp-for="PhoneNumber" class="section-title h5 mb-3" style="display:block;">Phone Number</label>
                    <input asp-for="PhoneNumber" type="tel" class="input-barbershop w-100" />
                    <span asp-validation-for="PhoneNumber" class="text-danger" style="color:#D97B2B !important; font-size:0.85em;"></span>
                </div>

                <div class="form-group mb-4" style="margin-bottom: 1.5rem;">
                    <label asp-for="Role" class="section-title h5 mb-3" style="display:block;">Role</label>
                    <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()" class="input-barbershop w-100"></select>
                    <span asp-validation-for="Role" class="text-danger" style="color:#D97B2B !important; font-size:0.85em;"></span>
                </div>

                <div style="margin-top:2rem; display:flex; gap:1rem; align-items:center;">
                    <button type="submit" class="btn-outline-brass">Save Changes</button>
                    <a href="/Users/Details/@Model.Id" class="back-link" style="color: var(--color-text-muted); text-decoration: none; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9em;">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
