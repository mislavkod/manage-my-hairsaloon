@model manage_my_hairsaloon.ViewModels.EditStaffViewModel

@{
    ViewData["Title"] = $"Edit Staff — {Model.StaffFullName}";
}

<div class="page-header">
    <h1>Edit Staff Member</h1>
    <p style="color: var(--color-text-muted); font-size: 1.1em; letter-spacing: 0.1em; text-transform: uppercase;">
        @Model.StaffFullName
    </p>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        
        <div asp-validation-summary="ModelOnly" style="background: rgba(201,168,76,0.15); border: 1px solid #C9A84C; border-radius:4px; padding:1rem; margin-bottom:1.5rem; color:#F5ECD7;"></div>

        <div class="card-barbershop leather-texture p-4 p-md-5">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="OriginalUserId" />
                <input type="hidden" asp-for="OriginalSpecialization" />
                <input type="hidden" asp-for="OriginalHourlyRate" />
                <input type="hidden" asp-for="OriginalIsAvailable" />

                <div class="form-group mb-4" style="margin-bottom: 1.5rem;">
                    <h2 class="section-title h5 mb-3">User</h2>
                    <select asp-for="UserId" class="input-barbershop w-100">
                        <option value="">-- Select User --</option>
                        @if (Model.Users != null)
                        {
                            foreach (var u in Model.Users)
                            {
                                <option value="@u.Id">@u.FirstName @u.LastName (@u.Email)</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="UserId" class="text-danger" style="color:#D97B2B !important; font-size:0.85em;"></span>
                </div>

                <div class="decorative-rule w-100 my-4"></div>

                <div class="form-group mb-4" style="margin-bottom: 1.5rem;">
                    <h2 class="section-title h5 mb-3">Specialization</h2>
                    <input asp-for="Specialization" class="input-barbershop w-100" placeholder="e.g., Master Barber, Colorist" />
                    <span asp-validation-for="Specialization" class="text-danger" style="color:#D97B2B !important; font-size:0.85em;"></span>
                </div>

                <div class="form-group mb-4" style="margin-bottom: 1.5rem;">
                    <h2 class="section-title h5 mb-3">Hourly Rate</h2>
                    <input asp-for="HourlyRate" type="number" step="0.01" min="0" class="input-barbershop w-100" placeholder="0.00" />
                    <span asp-validation-for="HourlyRate" class="text-danger" style="color:#D97B2B !important; font-size:0.85em;"></span>
                </div>

                <div class="form-group mb-4 flex-row" style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
                    <input asp-for="IsAvailable" type="checkbox" style="accent-color:#C9A84C; width:1.2rem; height:1.2rem; cursor:pointer;" />
                    <label asp-for="IsAvailable" style="cursor:pointer; font-size:1.1em; color: var(--color-text-on-dark);">Available for bookings</label>
                    <span asp-validation-for="IsAvailable" class="text-danger" style="color:#D97B2B !important; font-size:0.85em;"></span>
                </div>

                <div style="margin-top:2rem; display:flex; gap:1rem; align-items:center;">
                    <button type="submit" class="btn-outline-brass">Save Changes</button>
                    <a href="/Staff/Details/@Model.Id" class="back-link" style="color: var(--color-text-muted); text-decoration: none; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9em;">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
