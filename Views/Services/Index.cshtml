@model List<manage_my_hairsaloon.Models.Service>
@using System.Globalization
@{
    ViewData["Title"] = "Services";
    var active = ViewBag.ActiveCategory as string;
    decimal maxPrice = ViewBag.MaxPrice is decimal mp ? mp : 100m;
    string maxStr = maxPrice.ToString("F2", CultureInfo.InvariantCulture);
    string[] categories = { "HairCut", "Coloring", "Styling", "Treatment", "Beard", "Nails", "FacialTreatment" };
}

<div class="page-header">
    <h1>Services</h1>
</div>

@* Category filter buttons *@
<div class="filter-bar" style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:1rem;">
    <button type="button" class="btn-outline-brass @(active == null ? "active" : "")"
            data-category="" onclick="setCategory(this)">All</button>
    @foreach (var cat in categories)
    {
        <button type="button" class="btn-outline-brass @(active == cat ? "active" : "")"
                data-category="@cat" onclick="setCategory(this)">@cat</button>
    }
</div>

@* Text & price filters *@
<div class="filter-bar" style="display:flex; gap:1.5rem; flex-wrap:wrap; margin-bottom:1.5rem; align-items:flex-end;">
    <div style="display:flex; flex-direction:column; gap:0.3rem;">
        <label for="filterServiceName" class="spinner-step-label">Service Name</label>
        <input type="text" id="filterServiceName" class="input-barbershop"
               placeholder="Filter by service…" style="max-width:220px;" />
    </div>
    <div style="display:flex; flex-direction:column; gap:0.3rem;">
        <label for="filterSalonName" class="spinner-step-label">Salon</label>
        <input type="text" id="filterSalonName" class="input-barbershop"
               placeholder="Filter by salon…" style="max-width:220px;" />
    </div>
    <div style="display:flex; flex-direction:column; gap:0.5rem; min-width:240px;">
        <label for="filterMaxPrice" class="spinner-step-label">
            Max Price: <span id="maxPriceLabel" style="color:var(--clr-brass);">@maxPrice.ToString("C")</span>
        </label>
        <input type="range" id="filterMaxPrice"
               min="0" max="@maxStr" value="@maxStr" step="0.01"
               class="price-slider" />
    </div>
</div>

<div class="table-responsive">
    <table class="table-barbershop">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Duration</th>
                <th>Category</th>
                <th>Salon</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="servicesTableBody">
            @await Html.PartialAsync("_ServicesTable", Model)
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    var _activeCategory = '@Html.Raw(active ?? "")';
    var _debounceTimer = null;

    function setCategory(btn) {
        var cat = btn.dataset.category;
        _activeCategory = (_activeCategory === cat) ? '' : cat;
        document.querySelectorAll('[data-category]').forEach(function (b) {
            b.classList.toggle('active', b.dataset.category === _activeCategory);
        });
        doFetch();
    }

    function doFetch() {
        var params = new URLSearchParams({
            category: _activeCategory,
            serviceName: document.getElementById('filterServiceName').value,
            salonName: document.getElementById('filterSalonName').value,
            maxPrice: document.getElementById('filterMaxPrice').value
        });
        fetch('/services/filter?' + params.toString())
            .then(function (r) { return r.text(); })
            .then(function (html) {
                document.getElementById('servicesTableBody').innerHTML = html;
            });
    }

    function debounce() {
        clearTimeout(_debounceTimer);
        _debounceTimer = setTimeout(doFetch, 300);
    }

    document.getElementById('filterServiceName').addEventListener('input', debounce);
    document.getElementById('filterSalonName').addEventListener('input', debounce);
    document.getElementById('filterMaxPrice').addEventListener('input', function () {
        var val = parseFloat(this.value);
        document.getElementById('maxPriceLabel').textContent =
            val.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        debounce();
    });
</script>
}
