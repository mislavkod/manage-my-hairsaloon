@model List<manage_my_hairsaloon.Models.SalonPhoto>

@if (!Model.Any())
{
    <p class="text-muted fst-italic mt-2">No photos uploaded yet.</p>
}
else
{
    <div class="row g-3 mt-1">
        @foreach (var photo in Model)
        {
            <div class="col-6 col-md-4 col-lg-3" id="photo-@photo.Id">
                <div class="card-barbershop p-1 position-relative">
                    <img src="@photo.FilePath"
                         alt="@photo.FileName"
                         class="img-fluid rounded"
                         style="width:100%; height:420px; object-fit:cover;" />
                    <div class="d-flex justify-content-between align-items-center mt-1 px-1">
                        <small class="text-truncate" style="max-width:80%; font-size:0.7rem; color:var(--cream);">
                            @photo.FileName
                        </small>
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger py-0 px-1"
                                    style="font-size:0.7rem;"
                                    onclick="deletePhoto(@photo.Id)">
                                ✕
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
