@model manage_my_hairsaloon.Models.HairSalon
@{
    ViewData["Title"] = Model.Name;
    var returnUrl = Context.Request.Query["returnUrl"].FirstOrDefault();
    var salonReservations = Model.Staff?.SelectMany(s => s.Reservations ?? Enumerable.Empty<manage_my_hairsaloon.Models.Reservation>())
        .Where(r => r.Status == manage_my_hairsaloon.Models.ReservationStatus.Completed && (r.Reviews != null && r.Reviews.Any()))
        .ToList()
        ?? new List<manage_my_hairsaloon.Models.Reservation>();
    var salonReviews = salonReservations.SelectMany(r => r.Reviews ?? Enumerable.Empty<manage_my_hairsaloon.Models.Review>()).ToList();
}

<div class="page-header">
    <h1>@Model.Name</h1>
</div>

<div style="margin-bottom:1.5rem; display:flex; gap:1rem;">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-outline-brass">Edit</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this salon?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-outline-brass" style="border-color:#c0392b; color:#c0392b;">Delete</button>
        </form>
    }
</div>

<div class="card-barbershop">
    <dl class="detail-list">
        <dt>Address</dt>
        <dd>@Model.Address</dd>

        <dt>Phone Number</dt>
        <dd>@Model.PhoneNumber</dd>

        <dt>Email</dt>
        <dd>@Model.Email</dd>

        <dt>Created At</dt>
        <dd>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</dd>
    </dl>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <div style="margin-bottom:1.5rem;">
        <a href="/salons/@Model.Id/NewReservations" class="btn-outline-brass">Make a Reservation</a>
    </div>
}

@if (User.IsInRole("Admin") || (User.IsInRole("Staff") && ViewBag.CurrentUserSalonId == Model.Id))
{
    <div style="margin-bottom:1.5rem;">
        <a href="/salons/@Model.Id/NewStaff" class="btn-outline-brass">Add Staff Member</a>
    </div>
}

@if (Model.Staff != null && Model.Staff.Any())
{
    <h2 class="section-title">Staff Members</h2>
    <div class="filter-bar" style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:1rem;">
        <a href="/salons/@Model.Id/staff/available" class="btn-outline-brass">Available Staff Only</a>
    </div>
    <div class="table-responsive">
        <table class="table-barbershop">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Specialization</th>
                    <th>Hourly Rate</th>
                    <th>Available</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model.Staff)
                {
                    <tr>
                        <td>@staff.User?.FirstName @staff.User?.LastName</td>
                        <td>@staff.Specialization</td>
                        <td>@staff.HourlyRate.ToString("C")</td>
                        <td>
                            @if (staff.IsAvailable)
                            {
                                <span class="badge-available" style="padding:0.25em 0.6em; border-radius:2px; font-size:0.72rem; font-weight:700; text-transform:uppercase;">Available</span>
                            }
                            else
                            {
                                <span class="badge-unavailable" style="padding:0.25em 0.6em; border-radius:2px; font-size:0.72rem; font-weight:700; text-transform:uppercase;">Unavailable</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Staff" asp-action="Details" asp-route-id="@staff.Id" asp-route-returnUrl="@Context.Request.PathBase@Context.Request.Path" class="btn-outline-brass" style="font-size:0.72rem; padding:0.25rem 0.7rem;">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="divider-ornament">— ◆ —</div>

@if (User.IsInRole("Admin") || (User.IsInRole("Staff") && ViewBag.CurrentUserSalonId == Model.Id))
{
    <div style="margin-bottom:1.5rem;">
        <a href="/salons/@Model.Id/NewService" class="btn-outline-brass">Add New Service</a>
    </div>
}

@if (Model.Services != null && Model.Services.Any())
{
    <h2 class="section-title">Services</h2>
    <div class="table-responsive">
        <table class="table-barbershop">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Duration</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var service in Model.Services)
                {
                    <tr>
                        <td>@service.Name</td>
                        <td><span class="badge-brass">@service.Category</span></td>
                        <td>@service.Price.ToString("C")</td>
                        <td>@service.DurationMinutes min</td>
                        <td>
                            <a asp-controller="Services" asp-action="Details" asp-route-id="@service.Id" asp-route-returnUrl="@Context.Request.PathBase@Context.Request.Path" class="btn-outline-brass" style="font-size:0.72rem; padding:0.25rem 0.7rem;">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="divider-ornament">— ◆ —</div>

@if (salonReservations.Any())
{
    <h2 class="section-title">Reservations</h2>
    <div class="filter-bar" style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:1rem;">
        <a href="/HairSalons/Details/@Model.Id" class="btn-outline-brass">All</a>
        <a href="/salons/@Model.Id/reservations/status/Pending" class="btn-outline-brass">Pending</a>
        <a href="/salons/@Model.Id/reservations/status/Confirmed" class="btn-outline-brass">Confirmed</a>
        <a href="/salons/@Model.Id/reservations/status/Completed" class="btn-outline-brass">Completed</a>
        <a href="/salons/@Model.Id/reservations/status/Cancelled" class="btn-outline-brass">Cancelled</a>
        <a href="/salons/@Model.Id/reservations/status/NoShow" class="btn-outline-brass">NoShow</a>
    </div>

    @foreach (var res in salonReservations.OrderBy(r => r.ReservationDateTime))
    {
        var statusClass = res.Status switch {
            ReservationStatus.Pending => "badge-status-pending",
            ReservationStatus.Confirmed => "badge-status-confirmed",
            ReservationStatus.Completed => "badge-status-completed",
            ReservationStatus.Cancelled => "badge-status-cancelled",
            ReservationStatus.NoShow => "badge-status-noshow",
            _ => "badge-brass"
        };

        <div class="card-barbershop" style="margin-bottom:1.5rem;">

          <!-- Header -->
          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:0.5rem; margin-bottom:1rem;">
            <div>
              <span style="font-weight:700; color:var(--clr-brass);">@res.Customer?.FirstName @res.Customer?.LastName</span>
              <span style="color:var(--clr-sand); font-size:0.85rem; margin-left:0.75rem;">@res.ReservationDateTime.ToString("dd MMM yyyy, HH:mm")</span>
            </div>
            <span class="@statusClass" style="padding:0.25em 0.6em; border-radius:2px; font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em;">@res.Status</span>
          </div>

          <!-- Service + Staff row -->
          <div style="display:flex; gap:2rem; flex-wrap:wrap; margin-bottom:1rem;">
            <div>
              <div style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--clr-brass); margin-bottom:0.25rem;">Service</div>
              <div>@res.Service?.Name</div>
              <div style="margin-top:0.25rem;"><span class="badge-brass">@res.Service?.Category</span> &nbsp; @(res.Service != null ? res.Service.Price.ToString("C") : "") &nbsp; @res.Service?.DurationMinutes min</div>
            </div>
            <div>
              <div style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--clr-brass); margin-bottom:0.25rem;">Staff</div>
              <div>@res.Staff?.User?.FirstName @res.Staff?.User?.LastName</div>
              <div style="font-size:0.85rem; color:var(--clr-sand);">@res.Staff?.Specialization</div>
            </div>
          </div>

          <!-- Reviews (inline) -->
          @{
            var resReviews = res.Reviews ?? new List<manage_my_hairsaloon.Models.Review>();
          }
          @if (resReviews.Any())
          {
            <div style="border-top:1px solid rgba(201,168,76,0.3); padding-top:0.75rem; margin-top:0.5rem;">
              <div style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--clr-brass); margin-bottom:0.5rem;">Review</div>
              @foreach (var review in resReviews)
              {
                <div style="margin-bottom:0.5rem;">
                  <span class="rating-stars">
                      @for (int i = 0; i < review.Rating; i++) { <text>★</text> }@for (int i = review.Rating; i < 5; i++) { <text>☆</text> }
                  </span>
                  <span style="margin-left:0.5rem; color:var(--clr-sand); font-size:0.85rem;">(@review.Rating/5)</span>
                  @if (!string.IsNullOrEmpty(review.Comment))
                  {
                    <p style="margin:0.35rem 0 0; font-size:0.9rem;">@review.Comment</p>
                  }
                  <div style="font-size:0.8rem; color:var(--clr-sand); margin-top:0.25rem;">
                    — @review.Customer?.FirstName @review.Customer?.LastName &nbsp;·&nbsp; @review.CreatedAt.ToString("dd MMM yyyy")
                  </div>
                </div>
              }
            </div>
          }

          <!-- Write a Review button: only for Completed with no review -->
          @if (res.Status == manage_my_hairsaloon.Models.ReservationStatus.Completed && !resReviews.Any())
          {
            <div style="margin-top:0.75rem; padding-top:0.75rem; border-top:1px solid rgba(201,168,76,0.2);">
              <a href="/reservations/@res.Id/NewReview?salonId=@Model.Id" class="btn-outline-brass" style="font-size:0.8rem; padding:0.3rem 0.9rem;">✍ Write a Review</a>
            </div>
          }

          <!-- Details link -->
          <div style="margin-top:0.75rem; text-align:right;">
            <a asp-controller="Reservations" asp-action="Details" asp-route-id="@res.Id" asp-route-returnUrl="@Context.Request.PathBase@Context.Request.Path" class="btn-outline-brass" style="font-size:0.72rem; padding:0.25rem 0.7rem;">Details</a>
          </div>

        </div>
    }

    <div class="divider-ornament">— ◆ —</div>
}

@if (!string.IsNullOrEmpty(returnUrl) && Url.IsLocalUrl(returnUrl))
{
    <a href="@returnUrl" class="back-link">← Back</a>
}
else
{
    <a asp-controller="HairSalons" asp-action="Index" class="back-link">← Back to Hair Salons</a>
}

<div class="divider-ornament">— ◆ —</div>

<div class="section-title">Photos</div>

@if (User.IsInRole("Admin"))
{
    <form id="salonPhotoDz"
          action="/HairSalons/@Model.Id/UploadPhoto"
          enctype="multipart/form-data"
          class="dropzone"
          style="border:2px dashed var(--brass); background:rgba(201,168,76,0.05); border-radius:6px; min-height:120px; margin-bottom:1rem;">
    </form>
}

<div id="photoList"></div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/dropzone/dropzone.min.css" />
    <script src="~/lib/dropzone/dropzone.min.js"></script>
    <script>
        Dropzone.options.salonPhotoDz = {
            paramName: "file",
            acceptedFiles: "image/jpeg,image/png,image/webp",
            maxFilesize: 5,
            dictDefaultMessage: "Drop salon photos here or click to upload (JPEG, PNG, WebP · max 5 MB)",
            success: function (file, response) {
                loadPhotos();
                this.removeFile(file);
            },
            error: function (file, message) {
                alert("Upload failed: " + (message.title || message));
                this.removeFile(file);
            }
        };

        $(function () { loadPhotos(); });

        function loadPhotos() {
            $("#photoList").load("/HairSalons/@Model.Id/GetPhotos");
        }

        function deletePhoto(id) {
            $.ajax({
                url: "/HairSalons/DeletePhoto/" + id,
                method: "POST",
                success: function () { loadPhotos(); },
                error: function () { alert("Delete failed."); }
            });
        }
    </script>
}
